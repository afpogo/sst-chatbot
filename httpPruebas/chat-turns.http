@baseUrl = http://127.0.0.1:8091
@authUrl = http://localhost:4000/api/auth/internal/oauth/token
@clientId = sst-bend
@clientSecret = replace-with-local-secret

### Obtain exact sst-bend -> chatbot grant
# @name serviceGrant
POST {{authUrl}}
Content-Type: application/json

{
  "grant_type": "client_credentials",
  "client_id": "{{clientId}}",
  "client_secret": "{{clientSecret}}",
  "audience": "sst-chatbot",
  "scope": "chat:process"
}

### SST chatbot internal NDJSON turn
POST {{baseUrl}}/internal/v1/chat/turns
Authorization: Bearer {{serviceGrant.response.body.access_token}}
Content-Type: application/json

{
  "conversation_id": "smoke-conversation",
  "message_id": "smoke-message",
  "correlation_id": "smoke-correlation",
  "text": "hola desde smoke",
  "principal": {
    "user_id": "smoke-user",
    "account_id": "smoke-account",
    "tenant_id": "smoke-tenant"
  }
}
